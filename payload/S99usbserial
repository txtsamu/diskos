#!/bin/sh

LOG="${DISKOS_USBSERIAL_LOG:-/usr/data/fiio/usbserial.log}"
DEBUG="${DISKOS_DEBUG_SCRIPT:-/usr/project/diskos-debug.sh}"
TRIES="${DISKOS_USBSERIAL_TRIES:-3}"
PAUSE="${DISKOS_USBSERIAL_PAUSE:-5}"

log() { echo "$(date 2>/dev/null) $*" >> "$LOG" 2>/dev/null; }

start_usb_debug() {
	: > "$LOG" 2>/dev/null
	log "S99usbserial start"
	n=0
	while [ "$n" -lt "$TRIES" ]; do
		out=$("$DEBUG" usb-on 2>&1)
		rc=$?
		log "usb-on rc=$rc: $out"
		[ "$rc" -eq 0 ] && return 0
		[ "$rc" -eq 2 ] && return 1
		n=$((n+1))
		sleep "$PAUSE"
	done
	return 1
}

case "$1" in
	start) ( start_usb_debug ) </dev/null >/dev/null 2>&1 & ;;
	*) exit 1 ;;
esac
exit 0
