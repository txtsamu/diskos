#!/bin/sh
REC=${DISKOS_BOOT_SELECT:-/tmp/.diskos_boot_select}
WHY=$REC.why
PREF=${DISKOS_PREF_FILE:-/usr/data/boot_default_stock}
DATA_MNT=${DISKOS_DATA_MOUNT:-/usr/data}
PROBE=${DISKOS_BOOTPROBE:-/opt/diskos/bin/diskos-bootprobe}
MEMDEV=${DISKOS_MEMDEV:-/dev/mem}
DEADLINE_MS=${DISKOS_SELECT_DEADLINE_MS:-5000}

set -f

[ "$1" = start ] || exit 0
mkdir "$REC.decided" 2>/dev/null || exit 0

rm -f "$REC" "$REC.tmp" "$WHY" 2>/dev/null
rm -f /tmp/.diskos_boot_stock 2>/dev/null

decide() {
    printf '%s\n' "$2" > "$WHY" 2>/dev/null
    printf '%s\n' "$1" > "$REC.tmp" 2>/dev/null && mv -f "$REC.tmp" "$REC" 2>/dev/null
    exit 0
}

line=$("$PROBE" "$PREF" "$DATA_MNT" "$DEADLINE_MS" "$MEMDEV" 2>/dev/null)
prc=$?
[ "$prc" = 0 ] || decide stock "probe failed to run (rc=$prc)"

set -- $line
[ $# -eq 3 ] || decide stock "malformed probe result ($# fields): '$line'"
flag="$1"; rc="$2"; gpb="$3"
case "$flag" in
    0|1) ;;
    E) decide stock "preference lookup failed: $DATA_MNT not mounted, or lstat of $PREF failed other than ENOENT" ;;
    T) decide stock "timeout: the probe did not report within ${DEADLINE_MS}ms" ;;
    *) decide stock "probe could not complete: '$line'" ;;
esac
[ "$rc" = 0 ] || decide stock "pin read failed; default flag=$flag"
case "$gpb" in
    0[xX][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
    *) decide stock "malformed pin value '$gpb'; default flag=$flag" ;;
esac

volup=0
[ $(( gpb & 0x2000 )) -eq 0 ] && volup=1

if [ $(( flag ^ volup )) -eq 1 ]; then
    decide stock "flag=$flag volup=$volup gpb=$gpb"
fi
decide diskos "flag=$flag volup=$volup gpb=$gpb"
