#!/bin/sh
log_bg() {
    { [ -f /usr/data/diskos_rmguard.log ] && [ "$(/bin/busybox wc -c < /usr/data/diskos_rmguard.log 2>/dev/null)" -gt 65536 ]; } \
        || echo "$(/bin/busybox date '+%F %T' 2>/dev/null) $1" >> /usr/data/diskos_rmguard.log 2>/dev/null
}

options=1
for a in "$@"; do
    if [ "$options" = 1 ]; then
        case "$a" in --) options=0; continue ;; -*) continue ;; esac
    fi
    resolved=$(/bin/busybox readlink -f -- "$a" 2>/dev/null)
    for operand in "$a" "$resolved"; do
    case "$operand" in
        /tmp/sdcard|/tmp/sdcard/)
            /bin/busybox rmdir /tmp/sdcard 2>/dev/null
            log_bg "rmdir-only: rm $*" &
            exit 0 ;;
        /|/tmp|/tmp/|/tmp/sdcard/*)
            log_bg "blocked: rm $*" &
            exit 0 ;;
    esac
    done
done
exec /bin/busybox rm "$@"
