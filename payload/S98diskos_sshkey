#!/bin/sh
# diskOS (txtsamu fork): key-only development SSH on port 2222 at boot.
# Does nothing unless /usr/data/sshd/root_home/.ssh/authorized_keys exists, so an image without a
# provisioned key exposes no new service. Backgrounded so a slow /usr/data never delays boot.

case "$1" in
    start|"") ;;
    *) exit 0 ;;
esac

[ -s /usr/data/sshd/root_home/.ssh/authorized_keys ] || exit 0
( sleep 3; /usr/project/diskos-debug.sh key-on >> /usr/data/sshd/key-on.log 2>&1 ) </dev/null >/dev/null 2>&1 &
exit 0
